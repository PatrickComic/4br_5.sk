DirectoryIndex index.php pat.si.php
<FilesMatch "(?i)(\.(sqlite|sqlite3|sql|db)(-journal|-wal|-shm)?$|^config\..*\.php$|\.(md|json|log|zip)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
